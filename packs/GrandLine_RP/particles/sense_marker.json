{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "grandline:sense_marker",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/grandline/particle/marker"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.55
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          0,
          "math.sin(v.particle_age * 360) * 0.08",
          0
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          0.22,
          0.22
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.color.r ?? 1",
          "variable.color.g ?? 0.1",
          "variable.color.b ?? 0.1",
          "math.min(1, (1 - v.particle_age / v.particle_lifetime) * 3)"
        ]
      }
    }
  }
}
