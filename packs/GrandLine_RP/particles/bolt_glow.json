{
  "format_version": "1.21.0",
  "particle_effect": {
    "description": {
      "identifier": "grandline:bolt_glow",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/grandline/particle/bolt"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "variable.life ?? 0.18"
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_motion_dynamic": {},
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(variable.len ?? 1.0) * 0.5 + 0.03",
          "(variable.width ?? 0.15) * (1.0 - v.particle_age / v.particle_lifetime * 0.6)"
        ],
        "facing_camera_mode": "lookat_direction",
        "direction": {
          "mode": "custom",
          "custom_direction": [
            "variable.dx ?? 1.0",
            "variable.dy ?? 0.0",
            "variable.dz ?? 0.0"
          ]
        },
        "uv": {
          "texture_width": 32,
          "texture_height": 8,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            8
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.color.r ?? 1",
          "variable.color.g ?? 0.1",
          "variable.color.b ?? 0.1",
          "(1 - v.particle_age / v.particle_lifetime) * (0.75 + math.random(0, 0.25))"
        ]
      }
    }
  }
}
