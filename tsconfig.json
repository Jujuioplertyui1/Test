{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "lib": [
      "ES2020"
    ],
    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": false,
    "rootDir": "scripts-src",
    "removeComments": false,
    "newLine": "lf",
    "noEmit": true
  },
  "include": [
    "scripts-src/**/*.ts"
  ]
}
